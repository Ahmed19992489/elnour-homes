{
  "version": 2,
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/api/trpc/:match*",
      "destination": "/api"
    },
    {
      "source": "/api/:match*",
      "destination": "/api"
    },
    {
      "source": "/((?!api|assets|favicon|robots\\.txt|sitemap\\.xml).*)",
      "destination": "/index.html"
    }
  ]
}
